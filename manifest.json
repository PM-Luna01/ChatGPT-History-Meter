{
  "manifest_version": 3,
  "name": "ChatGPT History Meter",
  "version": "1.5.0",
  "description": "Estimates active-branch ChatGPT conversation history locally. Effective model prompt usage is not observable.",
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "page_script.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "ChatGPT History Meter"
  }
}
